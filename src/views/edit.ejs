<!DOCTYPE html>
<html lang="en">
    
<%- include('partials/head.ejs') %>

<body>
    
    <h1><%= title %></h1>

    <%- include('partials/navbar.ejs') %>

    <form action="/edit/<%= user._id %>" method="post">
        <div>
            <label>Name</label>
            <input type="text" name="name" placeholder="Type your Name" value="<%= user.name %>">
        </div>
        <div>
            <label>Age</label>
            <input type="number" name="age" placeholder="Type your Age" value="<%= user.age %>">
        </div>
        <div>
            <label>Email</label>
            <input type="text" name="email" placeholder="Type your Email" value="<%= user.email %>">
        </div>
        <button type="submit">Editar</button>
    </form>


    <%- include('partials/foot.ejs') %>
    <script src="js/main.js"></script>
</body>
</html>